# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID создателя бота (администратора), который подтверждает оптовиков.
# Узнать свой ID можно у @userinfobot или @getmyid_bot
ADMIN_TELEGRAM_ID=

# Подключение к PostgreSQL (обязательно на Render, чтобы роли оптовиков не слетали
# при перезапуске). Создать бесплатную БД: Dashboard -> New -> PostgreSQL.
# Если не задана — используется локальный файл data/bot.db.
DATABASE_URL=postgresql://user:password@host:5432/dbname
